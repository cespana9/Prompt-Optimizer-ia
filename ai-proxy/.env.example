# Do not put real credentials in this file or commit a .env file.
# Set these values as Cloudflare Worker secrets/variables instead.

# Secret (set with: npx wrangler secret put OPENAI_API_KEY)
OPENAI_API_KEY=
CLIENT_TOKEN_HASHES=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=
MIMO_BASE_URL=
AI_BASE_URL=
AI_API_KEY=

# Non-secret variables
ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
DEFAULT_MODEL=gpt-6-astra
DEFAULT_PROVIDER=openai
MAX_PROMPT_CHARS=12000
REQUEST_TIMEOUT_MS=25000
RATE_LIMIT_PER_DAY=100
PROVIDER_MODELS={"openai":["gpt-6-astra"],"gemini":["CONFIGURA_UN_MODELO"],"openrouter":["CONFIGURA_UN_MODELO"]}
